# Server-side only. Never commit real keys.
CIMIS_APP_KEY=
OPENET_API_KEY=
# Fetch-machine only: scripts/fetch-earthdata.ts uses this token; the website reads saved files without it.
EARTHDATA_TOKEN=
# AI field advisor (Google Gemini free tier). Create a key in Google AI Studio. Server-side only.
GEMINI_API_KEY=
# Optional. Defaults to a free-tier model named in src/lib/advisor/model.ts.
GEMINI_MODEL=
